# 🔑 Configuración de EmailJS - REEMPLAZA ESTOS VALORES

# ⚠️ IMPORTANTE: Estos son valores de ejemplo, debes reemplazarlos con tus valores reales de EmailJS

# Service ID (se ve como: service_xxxxxxx)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_tu_servicio_id_aqui

# Template ID para contacto (se ve como: template_xxxxxxx)  
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=template_contacto_id_aqui

# Template ID para compras (se ve como: template_xxxxxxx)
NEXT_PUBLIC_EMAILJS_PURCHASE_TEMPLATE_ID=template_compras_id_aqui

# Public Key (se ve como una cadena de letras y números)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key_aqui

# 📋 Para obtener estos valores:
# 1. Ve a https://dashboard.emailjs.com/
# 2. Service ID: En "Email Services"
# 3. Template IDs: En "Email Templates" 
# 4. Public Key: En "Account" → "General"